        {
          "flowAlias": "browser-stepup loa1 credential",
          "requirement": "REQUIRED",
          "priority": 30,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-stepup loa1 credential",
