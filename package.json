{
  "name": "@velcure/keycloak-theme",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Native Velcure Keycloak login, account and email themes with an Astro SSR review studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/velcure/keycloak-theme.git"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "render": "node scripts/render.mjs",
    "build": "pnpm render && astro build",
    "build:theme": "node scripts/build-theme.mjs",
    "check": "pnpm typecheck && biome check . && node --test tests/*.test.mjs",
    "format": "biome format --write .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "astro sync && tsc --noEmit",
    "test:account": "playwright test --config playwright.account.config.ts"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "qrcode": "1.5.4",
    "typescript": "7.0.2"
  }
}
